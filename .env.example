DATABASE_URL="<sqlite-or-postgresql-database-url>"
VENVIEWER_LITE_BASE_URL="https://example.com"
VENVIEWER_LITE_ADMIN_EMAIL="admin@example.com"
VENVIEWER_LITE_ADMIN_PASSWORD_HASH="$2b$12$placeholderplaceholderplaceholderplaceholderplacehold"
VENVIEWER_LITE_SESSION_SECRET="replace-with-at-least-32-random-characters"
VENVIEWER_LITE_DEPLOY_ENV="<development-test-or-production>"

# Asset storage. Local is the default in development and test.
# Production asset routes require STORAGE_PROVIDER=r2 and the R2_* variables.
# The rest of the site keeps working when those are unset.
STORAGE_PROVIDER="local"
STORAGE_LOCAL_ROOT="./storage"
STORAGE_BUCKET="venviewer-local"
VENVIEWER_DELIVERY_SECRET="replace-with-at-least-32-random-characters"
ASSET_MAX_BYTES="52428800"

# Production object storage (required only for asset upload and delivery).
# STORAGE_PROVIDER="r2"
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET=""
# R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# R2_REGION="auto"
