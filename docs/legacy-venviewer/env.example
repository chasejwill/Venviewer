DATABASE_URL="file:./dev.db"
VENVIEWER_DEPLOY_ENV="development"
VENVIEWER_BASE_URL="http://localhost:3100"
NEXT_PUBLIC_VENVIEWER_BASE_URL="http://localhost:3100"

# Production public origin
# VENVIEWER_BASE_URL="https://tour.venview.co"
# NEXT_PUBLIC_VENVIEWER_BASE_URL="https://tour.venview.co"

VENVIEWER_SESSION_SECRET="change-me-in-production"
VENVIEWER_DELIVERY_SECRET="change-me-in-production"
VENVIEWER_ADMIN_EMAIL="admin@venview.local"
VENVIEWER_ADMIN_PASSWORD="venviewer"
VENVIEWER_DEFAULT_ORG_NAME="Venview"

# Comma-separated domains allowed when embed policy is venview_only.
# os.venview.co: venOS retired; kept as reference for a future Venview dashboard.
VENVIEWER_VENVIEW_EMBED_DOMAINS="venview.co,www.venview.co,tour.venview.co,os.venview.co"

# Storage (development)
STORAGE_PROVIDER="local"
STORAGE_LOCAL_ROOT="./storage"
STORAGE_BUCKET="venviewer-local"

# Storage (staging/production)
VENVIEWER_DEPLOY_ENV="production"
STORAGE_PROVIDER="r2"
R2_ACCOUNT_ID="your-account-id"
R2_ACCESS_KEY_ID="your-access-key-id"
R2_SECRET_ACCESS_KEY="your-secret-access-key"
R2_BUCKET="venviewer"
R2_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
R2_REGION="auto"

# PostgreSQL (staging/production)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

ASSET_MAX_BYTES="52428800"

# R2 smoke test (staging)
# R2_SMOKE_TOUR_ID="your-tour-id"
