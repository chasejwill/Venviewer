{
  "name": "venviewer-lite",
  "version": "1.1.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "prisma generate --schema prisma/sqlite/schema.prisma && next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "auth:hash-password": "tsx scripts/hash-password.ts",
    "db:generate": "prisma generate --schema prisma/sqlite/schema.prisma",
    "db:push": "prisma db push --schema prisma/sqlite/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/sqlite/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:deploy:sqlite": "prisma migrate deploy --schema prisma/sqlite/schema.prisma",
    "db:seed": "prisma generate --schema prisma/sqlite/schema.prisma && tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@prisma/client": "6.19.1",
    "bcryptjs": "^3.0.3",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.12",
    "prettier": "3.9.6",
    "prisma": "6.19.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
